---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Introduction — Design System">
  <div class="intro">
    <div class="intro-header">
      <p class="intro-eyebrow">Design System</p>
      <h1 class="intro-title">Build with intention.</h1>
      <p class="intro-description">
        A token-first design system with a three-tier architecture — primitives,
        semantic aliases, and component tokens — for consistent, themeable
        interfaces.
      </p>
    </div>

    <div class="quick-links">
      <a href="/getting-started/installation" class="quick-link">
        <span class="quick-link-title">Installation</span>
        <span class="quick-link-desc">Add the package to your project</span>
      </a>
      <a href="/foundations/colors" class="quick-link">
        <span class="quick-link-title">Color Tokens</span>
        <span class="quick-link-desc">Explore the semantic color palette</span>
      </a>
      <a href="/components/button" class="quick-link">
        <span class="quick-link-title">Components</span>
        <span class="quick-link-desc">Browse component token reference</span>
      </a>
    </div>
  </div>
</Layout>

<style>
  .intro {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .intro-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .intro-eyebrow {
    margin: 0;
    font-family: var(--primitives-font-sans);
    font-size: var(--primitives-text-2xs);
    font-weight: var(--primitives-weight-semibold);
    letter-spacing: var(--primitives-tracking-caps);
    text-transform: uppercase;
    color: var(--semantic-color-accent-default);
  }

  .intro-title {
    font-size: var(--primitives-text-4xl);
    letter-spacing: var(--primitives-tracking-tight);
  }

  .intro-description {
    margin: 0;
    font-size: var(--primitives-text-md);
    color: var(--semantic-color-foreground-muted);
    line-height: var(--primitives-leading-relaxed);
    max-width: 60ch;
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .quick-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem;
    background-color: var(--semantic-color-background-raised);
    border: 1px solid var(--semantic-color-border-default);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .quick-link:hover {
    border-color: var(--semantic-color-accent-default);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .quick-link-title {
    font-family: var(--primitives-font-sans);
    font-size: var(--primitives-text-sm);
    font-weight: var(--primitives-weight-semibold);
    color: var(--semantic-color-foreground-default);
  }

  .quick-link-desc {
    font-family: var(--primitives-font-sans);
    font-size: var(--primitives-text-xs);
    color: var(--semantic-color-foreground-subtle);
  }
</style>
