---
import Layout from '../../layouts/Layout.astro';

const groups = [
  {
    label: 'Background',
    description: 'Surface colors for layering UI elements.',
    tokens: [
      { name: '--semantic-color-background-default', label: 'Default' },
      { name: '--semantic-color-background-raised', label: 'Raised' },
      { name: '--semantic-color-background-sunken', label: 'Sunken' },
      { name: '--semantic-color-background-muted', label: 'Muted' },
    ],
  },
  {
    label: 'Foreground',
    description: 'Text and icon colors at varying emphasis levels.',
    tokens: [
      { name: '--semantic-color-foreground-default', label: 'Default' },
      { name: '--semantic-color-foreground-muted', label: 'Muted' },
      { name: '--semantic-color-foreground-subtle', label: 'Subtle' },
      { name: '--semantic-color-foreground-faint', label: 'Faint' },
      { name: '--semantic-color-foreground-on-accent', label: 'On Accent' },
      { name: '--semantic-color-foreground-inverse', label: 'Inverse' },
    ],
  },
  {
    label: 'Border',
    description: 'Dividers, outlines, and separators.',
    tokens: [
      { name: '--semantic-color-border-default', label: 'Default' },
      { name: '--semantic-color-border-strong', label: 'Strong' },
      { name: '--semantic-color-border-subtle', label: 'Subtle' },
      { name: '--semantic-color-border-warm', label: 'Warm' },
    ],
  },
  {
    label: 'Accent',
    description: 'Primary interactive and brand color ramp.',
    tokens: [
      { name: '--semantic-color-accent-default', label: 'Default' },
      { name: '--semantic-color-accent-hover', label: 'Hover' },
      { name: '--semantic-color-accent-press', label: 'Press' },
      { name: '--semantic-color-accent-soft', label: 'Soft' },
      { name: '--semantic-color-accent-foreground', label: 'Foreground' },
    ],
  },
  {
    label: 'Secondary',
    description: 'Secondary interactive color for muted actions.',
    tokens: [
      { name: '--semantic-color-secondary-default', label: 'Default' },
      { name: '--semantic-color-secondary-hover', label: 'Hover' },
      { name: '--semantic-color-secondary-soft', label: 'Soft' },
    ],
  },
  {
    label: 'Status',
    description: 'Semantic status colors for feedback and alerts.',
    tokens: [
      { name: '--semantic-color-status-success-default', label: 'Success' },
      { name: '--semantic-color-status-success-foreground', label: 'Success Foreground' },
      { name: '--semantic-color-status-success-background', label: 'Success Background' },
      { name: '--semantic-color-status-danger-default', label: 'Danger' },
      { name: '--semantic-color-status-danger-foreground', label: 'Danger Foreground' },
      { name: '--semantic-color-status-danger-background', label: 'Danger Background' },
      { name: '--semantic-color-status-warning-default', label: 'Warning' },
      { name: '--semantic-color-status-warning-foreground', label: 'Warning Foreground' },
      { name: '--semantic-color-status-warning-background', label: 'Warning Background' },
      { name: '--semantic-color-status-info-default', label: 'Info' },
      { name: '--semantic-color-status-info-foreground', label: 'Info Foreground' },
      { name: '--semantic-color-status-info-background', label: 'Info Background' },
    ],
  },
];

const anatomyCallouts = [
  { n: 1, swatch: '--semantic-color-background-default', token: '--semantic-color-background-default', role: 'Page canvas — the base layer all content rests on.' },
  { n: 2, swatch: '--semantic-color-background-raised', token: '--semantic-color-background-raised', role: 'Card surface — one step above the page.' },
  { n: 3, swatch: '--semantic-color-border-default', token: '--semantic-color-border-default', role: 'Card border — separates surfaces from each other.' },
  { n: 4, swatch: '--semantic-color-foreground-default', token: '--semantic-color-foreground-default', role: 'Primary text — headings and labels.' },
  { n: 5, swatch: '--semantic-color-foreground-muted', token: '--semantic-color-foreground-muted', role: 'Supporting text — body copy and descriptions.' },
  { n: 6, swatch: '--semantic-color-accent-default', token: '--semantic-color-accent-default + --semantic-color-accent-foreground', role: 'Primary action — accent fill with guaranteed-contrast foreground.' },
  { n: 7, swatch: '--semantic-color-secondary-soft', token: '--semantic-color-secondary-soft + --semantic-color-secondary-default', role: 'Secondary action — muted fill with secondary foreground.' },
];
---

<Layout title="Colors — Design System">
  <div class="page">

    <header class="page-header">
      <p class="eyebrow">Foundations</p>
      <h1>Colors</h1>
      <p class="lead">
        Semantic color tokens alias the raw primitive palette into meaningful
        roles. Reference these tokens in your CSS — never the primitives
        directly — so that light and dark themes work automatically.
      </p>
    </header>

    <!-- ─── Anatomy ─── -->
    <section class="section">
      <div class="section-header">
        <h2>Anatomy</h2>
        <p class="section-desc">
          A single card illustrates how the color roles work together. Each
          numbered callout corresponds to a token in the legend below.
        </p>
      </div>

      <div class="anatomy-wrap">
        <!-- clean card demo — no overlaid badges -->
        <div class="anatomy-demo" aria-hidden="true">
          <div class="anatomy-page">
            <div class="anatomy-card">
              <div class="anatomy-card-inner">
                <div class="anatomy-text">
                  <p class="anatomy-title">Invoice #1042</p>
                  <p class="anatomy-body">Due on June 15 · $240.00</p>
                </div>
                <div class="anatomy-actions">
                  <button class="anatomy-btn-primary">Pay now</button>
                  <button class="anatomy-btn-secondary">Dismiss</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- legend: number + swatch + token + description -->
        <ol class="anatomy-legend">
          {anatomyCallouts.map((item) => (
            <li class="legend-item">
              <span class="legend-n" aria-hidden="true">{item.n}</span>
              <span
                class="legend-swatch"
                style={`background-color: var(${item.swatch});`}
                aria-hidden="true"
              />
              <div class="legend-text">
                <code class="legend-token">{item.token}</code>
                <span class="legend-role">{item.role}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ─── Background surfaces ─── -->
    <section class="section">
      <div class="section-header">
        <h2>Background surfaces</h2>
        <p class="section-desc">
          The four background tokens create a depth hierarchy — page, card,
          inset, fill — without relying on shadows. Use them consistently so
          users can orient themselves spatially within a layout.
        </p>
      </div>

      <!-- live demo using all four surfaces -->
      <div class="sf-demo-wrap">
        <div class="sf-demo" aria-hidden="true">
          <div class="sf-page">
            <div class="sf-panel">
              <p class="sf-panel-label">Active filters</p>
              <div class="sf-chips">
                <span class="sf-chip">Design</span>
                <span class="sf-chip">Research</span>
                <span class="sf-chip">2026</span>
              </div>
              <div class="sf-input-row">
                <div class="sf-input">Search projects...</div>
              </div>
            </div>
          </div>
        </div>
        <ol class="sf-legend">
          <li class="sf-legend-item">
            <span class="sf-swatch" style="background-color: var(--semantic-color-background-default);" aria-hidden="true" />
            <div class="sf-legend-text">
              <code class="sf-token">background-default</code>
              <span class="sf-role">Page — the base layer of every layout</span>
            </div>
          </li>
          <li class="sf-legend-item">
            <span class="sf-swatch" style="background-color: var(--semantic-color-background-raised);" aria-hidden="true" />
            <div class="sf-legend-text">
              <code class="sf-token">background-raised</code>
              <span class="sf-role">Card — content container elevated above the page</span>
            </div>
          </li>
          <li class="sf-legend-item">
            <span class="sf-swatch" style="background-color: var(--semantic-color-background-muted);" aria-hidden="true" />
            <div class="sf-legend-text">
              <code class="sf-token">background-muted</code>
              <span class="sf-role">Muted fill — chips, tags, and subtle non-interactive highlights</span>
            </div>
          </li>
          <li class="sf-legend-item">
            <span class="sf-swatch" style="background-color: var(--semantic-color-background-sunken);" aria-hidden="true" />
            <div class="sf-legend-text">
              <code class="sf-token">background-sunken</code>
              <span class="sf-role">Sunken — inset wells, code blocks, and selected rows inside a raised surface</span>
            </div>
          </li>
        </ol>
      </div>

      <!-- per-surface description cards -->
      <div class="sf-grid">

        <div class="sf-card">
          <div class="sf-card-swatch" style="background-color: var(--semantic-color-background-default);" aria-hidden="true" />
          <div class="sf-card-body">
            <p class="sf-card-name">Default</p>
            <p class="sf-card-desc">
              The page canvas. It is the outermost surface — every other layer
              sits on top of it. Because it is the baseline, it should never
              appear inside a raised container.
            </p>
            <ul class="sf-card-uses">
              <li>Page and app shell backgrounds</li>
              <li>Empty-state areas</li>
              <li>The space between cards in a grid</li>
            </ul>
          </div>
        </div>

        <div class="sf-card">
          <div class="sf-card-swatch" style="background-color: var(--semantic-color-background-raised);" aria-hidden="true" />
          <div class="sf-card-body">
            <p class="sf-card-name">Raised</p>
            <p class="sf-card-desc">
              The primary content surface, elevated one step above the page.
              This is the most commonly used background — almost every discrete
              piece of UI sits on it.
            </p>
            <ul class="sf-card-uses">
              <li>Cards, panels, and list items</li>
              <li>Modals, drawers, and dialogs</li>
              <li>Dropdown menus, tooltips, popovers</li>
              <li>The sidebar and top navigation</li>
            </ul>
          </div>
        </div>

        <div class="sf-card">
          <div class="sf-card-swatch" style="background-color: var(--semantic-color-background-sunken);" aria-hidden="true" />
          <div class="sf-card-body">
            <p class="sf-card-name">Sunken</p>
            <p class="sf-card-desc">
              An inset surface that appears recessed within a raised container.
              Note: input fields use their own component token
              (<code>--component-input-background</code>) rather than this
              surface — their "sunken" effect comes from an inset shadow, not
              background color.
            </p>
            <ul class="sf-card-uses">
              <li>Code blocks and preformatted text</li>
              <li>Selected or active table rows</li>
              <li>Info wells and callout insets</li>
              <li>Image placeholder areas</li>
            </ul>
          </div>
        </div>

        <div class="sf-card">
          <div class="sf-card-swatch" style="background-color: var(--semantic-color-background-muted);" aria-hidden="true" />
          <div class="sf-card-body">
            <p class="sf-card-name">Muted</p>
            <p class="sf-card-desc">
              A lightly tinted fill for non-interactive elements that need
              visual distinction without implying depth. Unlike the others,
              muted is not a depth level — it is a categorical fill.
            </p>
            <ul class="sf-card-uses">
              <li>Chips, pills, and filter tags</li>
              <li>Neutral badges</li>
              <li>Table row hover states</li>
              <li>Skeleton / loading placeholders</li>
            </ul>
          </div>
        </div>

      </div>
    </section>

    <!-- ─── Dos & Don'ts ─── -->
    <section class="section">
      <div class="section-header">
        <h2>Dos & Don'ts</h2>
        <p class="section-desc">
          Design decisions about how to apply color — not code, not token names.
        </p>
      </div>

      <div class="dd-list">

        <!-- 1: Surface layering -->
        <div class="dd-pair">
          <div class="dd-card dd-do">
            <p class="dd-verdict dd-verdict--do">Do</p>
            <div class="dd-example dd-example--fill">
              <div class="ex-page ex-page--default">
                <div class="ex-card">
                  <p class="ex-card-title">Upcoming payment</p>
                  <p class="ex-card-body">$240.00 due June 15</p>
                </div>
              </div>
            </div>
            <p class="dd-rule">Use distinct background layers — default for the page, raised for cards — so surfaces separate from each other without relying on shadows.</p>
          </div>
          <div class="dd-card dd-dont">
            <p class="dd-verdict dd-verdict--dont">Don't</p>
            <div class="dd-example dd-example--fill">
              <div class="ex-page ex-page--raised">
                <div class="ex-card">
                  <p class="ex-card-title">Upcoming payment</p>
                  <p class="ex-card-body">$240.00 due June 15</p>
                </div>
              </div>
            </div>
            <p class="dd-rule">Don't use the same background for the page and its cards. Without surface contrast, content loses its sense of depth and structure.</p>
          </div>
        </div>

        <!-- 2: Foreground hierarchy -->
        <div class="dd-pair">
          <div class="dd-card dd-do">
            <p class="dd-verdict dd-verdict--do">Do</p>
            <div class="dd-example dd-example--col">
              <p class="ex-hier-title">Payment received</p>
              <p class="ex-hier-body">Your invoice has been paid in full.</p>
              <p class="ex-hier-meta">June 15 · Ref #A4920</p>
            </div>
            <p class="dd-rule">Step down text emphasis — strong contrast for headings, muted for body, subtle for metadata. Important information stands out; supporting detail recedes.</p>
          </div>
          <div class="dd-card dd-dont">
            <p class="dd-verdict dd-verdict--dont">Don't</p>
            <div class="dd-example dd-example--col">
              <p class="ex-flat-title">Payment received</p>
              <p class="ex-flat-body">Your invoice has been paid in full.</p>
              <p class="ex-flat-meta">June 15 · Ref #A4920</p>
            </div>
            <p class="dd-rule">Don't use maximum contrast for all text levels. Equal weight across every line removes the reading hierarchy and makes content harder to scan.</p>
          </div>
        </div>

        <!-- 3: Accent restraint -->
        <div class="dd-pair">
          <div class="dd-card dd-do">
            <p class="dd-verdict dd-verdict--do">Do</p>
            <div class="dd-example">
              <div class="ex-actions">
                <button class="ex-btn-accent">Save changes</button>
                <button class="ex-btn-secondary-action">Preview</button>
                <button class="ex-btn-secondary-action">Cancel</button>
              </div>
            </div>
            <p class="dd-rule">Reserve the accent color for the single most important action. Its power as a focal point depends on scarcity — one accent per surface.</p>
          </div>
          <div class="dd-card dd-dont">
            <p class="dd-verdict dd-verdict--dont">Don't</p>
            <div class="dd-example">
              <div class="ex-actions">
                <button class="ex-btn-accent">Save changes</button>
                <button class="ex-btn-accent">Preview</button>
                <button class="ex-btn-accent">Cancel</button>
              </div>
            </div>
            <p class="dd-rule">Don't apply accent to multiple competing elements. When everything is high-emphasis, nothing is — users lose the signal for the primary action.</p>
          </div>
        </div>

        <!-- 4: Status color semantics -->
        <div class="dd-pair">
          <div class="dd-card dd-do">
            <p class="dd-verdict dd-verdict--do">Do</p>
            <div class="dd-example">
              <div class="ex-badges">
                <span class="ex-badge ex-badge--success">Delivered</span>
                <span class="ex-badge ex-badge--danger">Payment failed</span>
              </div>
            </div>
            <p class="dd-rule">Match status color to the actual outcome — success for completion, danger for errors or destructive actions. Users build trust with consistent signals.</p>
          </div>
          <div class="dd-card dd-dont">
            <p class="dd-verdict dd-verdict--dont">Don't</p>
            <div class="dd-example">
              <div class="ex-badges">
                <span class="ex-badge ex-badge--danger">New arrival</span>
                <span class="ex-badge ex-badge--danger">Trending</span>
              </div>
            </div>
            <p class="dd-rule">Don't use status colors to grab attention when there's no actual status to communicate. Decorative misuse erodes the meaning users have learned to trust.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- ─── Token reference ─── -->
    <section class="section">
      <div class="section-header">
        <h2>Token reference</h2>
        <p class="section-desc">Full inventory of all semantic color tokens.</p>
      </div>

      <div class="groups">
        {groups.map((group) => (
          <div class="group">
            <div class="group-header">
              <h3>{group.label}</h3>
              <p class="group-desc">{group.description}</p>
            </div>
            <div class="swatch-grid">
              {group.tokens.map((token) => (
                <div class="swatch-card">
                  <div
                    class="swatch-color"
                    style={`background-color: var(${token.name});`}
                    aria-hidden="true"
                  />
                  <div class="swatch-info">
                    <span class="swatch-label">{token.label}</span>
                    <code class="swatch-var">{token.name}</code>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ── layout ── */
  .page {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--semantic-color-border-default);
  }

  .eyebrow {
    margin: 0;
    font-size: var(--primitives-text-2xs);
    font-weight: var(--primitives-weight-semibold);
    letter-spacing: var(--primitives-tracking-caps);
    text-transform: uppercase;
    color: var(--semantic-color-accent-default);
  }

  h1 {
    font-size: var(--primitives-text-3xl);
    letter-spacing: var(--primitives-tracking-tight);
  }

  .lead {
    margin: 0;
    font-size: var(--primitives-text-md);
    color: var(--semantic-color-foreground-muted);
    line-height: var(--primitives-leading-relaxed);
    max-width: 65ch;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  h2 {
    font-size: var(--primitives-text-xl);
    letter-spacing: var(--primitives-tracking-snug);
  }

  .section-desc {
    margin: 0;
    font-size: var(--primitives-text-sm);
    color: var(--semantic-color-foreground-subtle);
    max-width: 60ch;
  }

  /* ── anatomy ── */
  .anatomy-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .anatomy-demo {
    border: 1px solid var(--semantic-color-border-default);
    border-radius: 10px;
    overflow: hidden;
  }

  .anatomy-page {
    padding: 2rem;
    background-color: var(--semantic-color-background-default);
  }

  .anatomy-card {
    background-color: var(--semantic-color-background-raised);
    border: 1px solid var(--semantic-color-border-default);
    border-radius: 10px;
    overflow: hidden;
  }

  .anatomy-card-inner {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .anatomy-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .anatomy-title {
    margin: 0;
    font-family: var(--primitives-font-display);
    font-size: var(--primitives-text-lg);
    font-weight: var(--primitives-weight-semibold);
    color: var(--semantic-color-foreground-default);
  }

  .anatomy-body {
    margin: 0;
    font-size: var(--primitives-text-sm);
    color: var(--semantic-color-foreground-muted);
  }

  .anatomy-actions {
    display: flex;
    gap: 0.5rem;
  }

  .anatomy-btn-primary,
  .anatomy-btn-secondary {
    padding: 0.5rem 1rem;
    font-family: var(--primitives-font-sans);
    font-size: var(--primitives-text-sm);
    font-weight: var(--primitives-weight-medium);
    border: none;
    border-radius: 6px;
    cursor: default;
  }

  .anatomy-btn-primary {
    background-color: var(--semantic-color-accent-default);
    color: var(--semantic-color-accent-foreground);
  }

  .anatomy-btn-secondary {
    background-color: var(--semantic-color-secondary-soft);
    color: var(--semantic-color-secondary-default);
  }

  /* legend */
  .anatomy-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 2rem;
  }

  @media (max-width: 600px) {
    .anatomy-legend {
      grid-template-columns: 1fr;
    }
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .legend-n {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    background-color: var(--semantic-color-foreground-default);
    color: var(--semantic-color-background-default);
    font-family: var(--primitives-font-mono);
    font-size: var(--primitives-text-2xs);
    font-weight: var(--primitives-weight-bold);
    border-radius: 50%;
  }

  .legend-swatch {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    border-radius: 3px;
    border: 1px solid var(--semantic-color-border-default);
  }

  .legend-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .legend-token {
    font-size: var(--primitives-text-2xs);
    color: var(--semantic-color-foreground-default);
    background: none;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .legend-role {
    font-size: var(--primitives-text-2xs);
    color: var(--semantic-color-foreground-subtle);
  }

  /* ── background surfaces ── */
  .sf-demo-wrap {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sf-demo {
    border: 1px solid var(--semantic-color-border-default);
    border-radius: 10px;
    overflow: hidden;
  }

  .sf-page {
    padding: 1.5rem;
    background-color: var(--semantic-color-background-default);
  }

  .sf-panel {
    background-color: var(--semantic-color-background-raised);
    border: 1px solid var(--semantic-color-border-default);
    border-radius: 10px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .sf-panel-label {
    margin: 0;
    font-size: var(--primitives-text-xs);
    font-weight: var(--primitives-weight-semibold);
    color: var(--semantic-color-foreground-subtle);
    letter-spacing: var(--primitives-tracking-caps);
    text-transform: uppercase;
  }

  .sf-chips {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .sf-chip {
    padding: 0.25rem 0.75rem;
