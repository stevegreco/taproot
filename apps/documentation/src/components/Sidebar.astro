---
const navItems = [
  {
    label: 'Getting Started',
    items: [
      { label: 'Introduction', href: '/' },
      { label: 'Installation', href: '/getting-started/installation' },
    ],
  },
  {
    label: 'Foundations',
    items: [
      { label: 'Colors', href: '/foundations/colors' },
      { label: 'Typography', href: '/foundations/typography' },
      { label: 'Spacing', href: '/foundations/spacing' },
    ],
  },
  {
    label: 'Components',
    items: [
      { label: 'Alert', href: '/components/alert' },
      { label: 'Badge', href: '/components/badge' },
      { label: 'Button', href: '/components/button' },
      { label: 'Card', href: '/components/card' },
      { label: 'Input', href: '/components/input' },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<nav class="sidebar" aria-label="Design system navigation">
  <a href="/" class="sidebar-logo">
    <span class="sidebar-logo-mark">DS</span>
    <span class="sidebar-logo-name">Design System</span>
  </a>

  {navItems.map((group) => (
    <div class="nav-group">
      <p class="nav-group-label">{group.label}</p>
      <ul class="nav-list">
        {group.items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { 'nav-link--active': currentPath === item.href }]}
              aria-current={currentPath === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 240px;
    min-width: 240px;
    height: 100vh;
    position: sticky;
    top: 0;
    padding: 1.5rem 1rem;
    background-color: var(--semantic-color-background-raised);
    border-right: 1px solid var(--semantic-color-border-default);
    overflow-y: auto;
    box-sizing: border-box;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    transition: background-color 0.15s ease;
  }

  .sidebar-logo:hover {
    background-color: var(--semantic-color-background-sunken);
  }

  .sidebar-logo-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background-color: var(--semantic-color-accent-default);
    color: var(--semantic-color-accent-foreground);
    font-family: var(--primitives-font-display);
    font-size: var(--primitives-text-sm);
    font-weight: var(--primitives-weight-bold);
    border-radius: 6px;
    letter-spacing: var(--primitives-tracking-wide);
    flex-shrink: 0;
  }

  .sidebar-logo-name {
    font-family: var(--primitives-font-sans);
    font-size: var(--primitives-text-sm);
    font-weight: var(--primitives-weight-semibold);
    color: var(--semantic-color-foreground-default);
    letter-spacing: var(--primitives-tracking-snug);
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-group-label {
    margin: 0 0 0.25rem 0.5rem;
    font-family: var(--primitives-font-sans);
    font-size: var(--primitives-text-2xs);
    font-weight: var(--primitives-weight-semibold);
    letter-spacing: var(--primitives-tracking-caps);
    text-transform: uppercase;
    color: var(--semantic-color-foreground-subtle);
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav-link {
    display: block;
    padding: 0.375rem 0.5rem;
    font-family: var(--primitives-font-sans);
    font-size: var(--primitives-text-sm);
    font-weight: var(--primitives-weight-regular);
    color: var(--semantic-color-foreground-muted);
    text-decoration: none;
    border-radius: 6px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .nav-link:hover {
    background-color: var(--semantic-color-background-muted);
    color: var(--semantic-color-foreground-default);
  }

  .nav-link--active {
    background-color: var(--semantic-color-accent-soft);
    color: var(--semantic-color-accent-default);
    font-weight: var(--primitives-weight-medium);
  }

  .nav-link--active:hover {
    background-color: var(--semantic-color-accent-soft);
    color: var(--semantic-color-accent-hover);
  }
</style>
