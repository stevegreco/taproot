---
import { checkText, loadComponentSlice, type ComponentSpecSection } from "../lib/component-spec";
import "./component-spec.css";

interface Props {
  component: string;
  section?: ComponentSpecSection;
}

const { component, section } = Astro.props;
const slice = loadComponentSlice(component);
// Astro renders a string-valued dynamic tag as that HTML element.
const Specimen = slice.tagName;

const titleCase = (value: string) =>
  value.replace(/^./, (character) => character.toUpperCase());

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");

const inlineMarkdown = (value: string) =>
  escapeHtml(value)
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');

const markdownToHtml = (markdown: string) => {
  const blocks = markdown.trim().split(/\n{2,}/);
  return blocks
    .map((block) => {
      const heading = block.match(/^(#{2,3})\s+(.+)$/);
      if (heading) {
        return `<h3>${inlineMarkdown(heading[2])}</h3>`;
      }
      // A list item may continue on indented lines, as rule details do.
      if (/^[-*]\s+/.test(block)) {
        const items: string[] = [];
        for (const line of block.split("\n")) {
          if (/^[-*]\s+/.test(line)) items.push(line.replace(/^[-*]\s+/, ""));
          else if (line.trim()) items[items.length - 1] += ` ${line.trim()}`;
        }
        return `<ul>${items.map((item) => `<li>${inlineMarkdown(item)}</li>`).join("")}</ul>`;
      }
      if (block.startsWith("```")) {
        const fenced = block.replace(/^```[a-z]*\n?/, "").replace(/```$/, "");
        return `<pre><code>${escapeHtml(fenced.trim())}</code></pre>`;
      }
      return `<p>${inlineMarkdown(block.replaceAll("\n", " "))}</p>`;
    })
    .join("");
};

const show = (name: ComponentSpecSection) => section == null || section === name;
---

{
  show("intro") && slice.introMarkdown ? (
    <div class="component-spec component-spec--prose" set:html={markdownToHtml(slice.introMarkdown)} />
  ) : null
}

{
  show("behavior") && slice.behaviorMarkdown ? (
    <div class="component-spec component-spec--prose" set:html={markdownToHtml(slice.behaviorMarkdown)} />
  ) : null
}

{
  show("variants") && slice.variants.length > 0 ? (
    <div class="component-spec component-spec__variants">
      {
        slice.variants.map((variant) => (
          <article class="component-spec__variant">
            <div class="component-spec__specimen">
              <Specimen variant={variant.name}>{variant.exampleLabel}</Specimen>
            </div>
            <div class="component-spec__variant-copy">
              <div class="component-spec__variant-heading">
                <h3>{titleCase(variant.name)}</h3>
                {variant.isDefault ? <span class="component-spec__default">Default</span> : null}
              </div>
              <p>{variant.description}</p>
              {variant.guidance ? (
                <div class="component-spec__guidance" set:html={markdownToHtml(variant.guidance)} />
              ) : null}
              <code>{variant.exampleHtml}</code>
            </div>
          </article>
        ))
      }
    </div>
  ) : null
}

{
  show("together") && slice.together ? (
    <div class="component-spec component-spec--together">
      {
        slice.together.patterns.map((pattern) => (
          <>
            {slice.together!.patterns.length > 1 ? <h3>{pattern.title}</h3> : null}
            <p>{pattern.summary}</p>
          </>
        ))
      }
      {
        slice.together.example ? (
          <figure class="component-spec__figure">
            <img
              src={slice.together.example.src}
              alt={slice.together.example.alt}
              width={slice.together.example.width}
              height={slice.together.example.height}
            />
            <figcaption>{slice.together.example.summary}</figcaption>
          </figure>
        ) : null
      }
      {
        slice.together.example && slice.together.example.annotations.length > 0 ? (
          <ul>
            {slice.together.example.annotations.map((annotation) => (
              <li>
                <strong>{annotation.label}.</strong> {annotation.description}
              </li>
            ))}
          </ul>
        ) : null
      }
      {
        slice.together.patterns
          .filter((pattern) => pattern.avoid.length > 0)
          .map((pattern) => (
            <>
              {slice.together!.patterns.length > 1 ? (
                <h4>Avoid: {pattern.title}</h4>
              ) : (
                <h3>Avoid</h3>
              )}
              <ul>
                {pattern.avoid.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          ))
      }
    </div>
  ) : null
}

{
  show("api") ? (
    <div class="component-spec">
      {
        [{ tagName: undefined, api: slice.api }, ...slice.items].map((group) => (
          <Fragment>
            {group.tagName ? (
              <h3>
                <code>{`<${group.tagName}>`}</code>
              </h3>
            ) : null}
            <table class="component-spec__table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>Type</th>
                  <th>Default</th>
                  <th>Description</th>
                </tr>
              </thead>
              <tbody>
                {group.api.map((row) => (
                  <tr>
                    <td>
                      <code>{row.name}</code>
                      {row.kind !== "attribute" ? <span class="component-spec__kind">{row.kind}</span> : null}
                    </td>
                    <td><code>{row.typeDisplay}</code></td>
                    <td>{row.defaultDisplay ? <code>{row.defaultDisplay}</code> : ""}</td>
                    <td>
                      {row.values.length > 0 ? (
                        <ul class="component-spec__values">
                          {row.values.map((value) => (
                            <li>
                              <code>{value.name}</code> {value.description}
                            </li>
                          ))}
                        </ul>
                      ) : (
                        row.description
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </Fragment>
        ))
      }
    </div>
  ) : null
}

{
  show("accessibility") ? (
    <div class="component-spec component-spec--prose">
      {
        slice.accessibility.requirements.length > 0 ? (
          <ul>
            {slice.accessibility.requirements.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ) : null
      }
      {
        slice.accessibility.keyboard.length > 0 ? (
          <table class="component-spec__table">
            <thead>
              <tr>
                <th>Key</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {slice.accessibility.keyboard.map((binding) => (
                <tr>
                  <td><code>{binding.key}</code></td>
                  <td>{binding.action}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : null
      }
    </div>
  ) : null
}

{
  show("review") && slice.review ? (
    <details id="review-checklist" class="component-spec component-spec__review">
      <summary>{slice.review.title}</summary>
      <ul>
        {slice.review.checks.map((check) => (
          <li>{checkText(check)}</li>
        ))}
      </ul>
    </details>
  ) : null
}

{show("variants") && slice.variants.length > 0 ? (
  <script>
    // The barrel registers every element under its default tag, so specimens
    // for any component upgrade without a per-tag import here.
    import "@stevegreco/design-system-components";
  </script>
) : null}
