---
import "./labs.css";
---

<section class="ds-lab not-prose" aria-label="Semantic background lab">
  <div class="background-map">
    <span class="map-label">background.default</span>
    <div class="brand-block">
      <div class="solid">brand.default</div>
      <div class="muted">brand.muted</div>
    </div>
    <section class="surface-card">
      <h2>background.surface</h2>
      <p>A containing surface placed on the default application background.</p>
      <div class="sunken-well">
        <b>background.sunken</b>
        <span>Recessed content and grouped control beds.</span>
      </div>
      <div class="muted-row">
        <span>background.muted</span>
        <span>Supporting region</span>
      </div>
      <div class="action-family primary">
        <b>background.action.primary</b>
        <div class="action-row">
          <div class="action-state default">default</div>
          <div class="action-state hover">hover</div>
          <div class="action-state pressed">pressed</div>
        </div>
      </div>
      <div class="action-family secondary">
        <b>background.action.secondary</b>
        <div class="action-row">
          <div class="action-state default">default</div>
          <div class="action-state hover">hover</div>
          <div class="action-state pressed">pressed</div>
        </div>
      </div>
      <div class="action-family tertiary">
        <b>background.action.tertiary</b>
        <div class="action-row">
          <div class="action-state default">transparent</div>
          <div class="action-state hover">hover</div>
          <div class="action-state pressed">pressed</div>
        </div>
      </div>
      <div class="action-family destructive">
        <b>background.action.destructive</b>
        <div class="action-row">
          <div class="action-state default">default</div>
          <div class="action-state hover">hover</div>
          <div class="action-state pressed">pressed</div>
        </div>
      </div>
      <div class="disabled-sample">background.disabled</div>
      <div class="status-row">
        <div class="status-fill success">success</div>
        <div class="status-fill warning">warning</div>
        <div class="status-fill info">info</div>
        <div class="status-fill danger">danger</div>
      </div>
    </section>
  </div>
</section>
