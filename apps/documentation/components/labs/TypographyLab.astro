---
import "./labs.css";

const recipes = [
  {
    name: "semantic.typography.heading.lg.*",
    meta: "Lora · 30 / tight · medium · tight",
    className: "type-heading-lg",
  },
  {
    name: "semantic.typography.heading.md.*",
    meta: "Lora · 24 / snug · medium · snug",
    className: "type-heading-md",
  },
  {
    name: "semantic.typography.heading.sm.*",
    meta: "Lora · 20 / snug · medium · snug",
    className: "type-heading-sm",
  },
  {
    name: "semantic.typography.body.md.*",
    meta: "Source Sans 3 · 16 / normal · regular · normal",
    className: "type-body-md",
  },
  {
    name: "semantic.typography.body.sm.*",
    meta: "Source Sans 3 · 14 / normal · regular · normal",
    className: "type-body-sm",
  },
  {
    name: "semantic.typography.title.*",
    meta: "Source Sans 3 · 16 / normal · semibold · normal",
    className: "type-semantic-title",
  },
  {
    name: "semantic.typography.label.md.*",
    meta: "Source Sans 3 · 14 / snug · medium · normal",
    className: "type-label-md",
  },
  {
    name: "semantic.typography.label.sm.*",
    meta: "Source Sans 3 · 12 / snug · medium · normal",
    className: "type-label-sm",
  },
  {
    name: "semantic.typography.eyebrow.*",
    meta: "Source Sans 3 · 12 / snug · medium · caps",
    className: "type-semantic-eyebrow",
  },
  {
    name: "semantic.typography.code.md.*",
    meta: "JetBrains Mono · 14 / normal · regular · normal",
    className: "type-code-md",
  },
  {
    name: "semantic.typography.code.sm.*",
    meta: "JetBrains Mono · 12 / normal · regular · normal",
    className: "type-code-sm",
  },
] as const;
---

<section class="ds-lab not-prose typography-lab" aria-label="Semantic typography lab">
  <div class="typography-board">
    <section class="typography-context-grid" aria-label="Typography in product context">
      <article class="typography-context-card">
        <p class="typography-context-label type-semantic-eyebrow">Design tokens</p>
        <h2 class="typography-specimen type-heading-lg">
          A system should make the right choice feel natural.
        </h2>
        <p class="type-body-md">
          Semantic typography gives recurring text roles a stable contract while allowing the
          underlying scale to evolve. Consumers can use individual properties, but the recipe
          remains the cohesive unit.
        </p>
        <div class="typography-action-row">
          <button class="typography-action type-label-md" type="button">Explore tokens</button>
          <span class="typography-context-muted type-label-sm">Published in CSS and JSON</span>
        </div>
        <p class="typography-context-muted type-body-sm">Updated August 2026 · 4 minute read</p>
      </article>
      <aside class="typography-context-card">
        <h2 class="typography-specimen type-heading-sm">Token anatomy</h2>
        <p class="type-body-sm">Each recipe publishes five independently consumable leaves.</p>
        <pre class="type-code-sm"><code>semantic.typography
  .body.md
  .fontFamily
  .fontSize
  .fontWeight
  .lineHeight
  .letterSpacing</code></pre>
        <p class="type-label-md">Cohesive by default</p>
        <p class="type-body-sm">
          Mixing leaves is possible, but the consumer owns the visual risk.
        </p>
        <p class="type-body-md">
          Use <code class="type-code-sm">body.md</code> for ordinary product copy.
        </p>
      </aside>
    </section>

    <section class="typography-reference" aria-label="All published typography recipes">
      <header class="typography-reference-header">
        <h2 class="type-heading-md">Published recipes</h2>
        <p class="typography-context-muted type-label-sm">10 recipes · 50 leaf tokens</p>
      </header>
      <div class="typography-recipe-list">
        {
          recipes.map((recipe) => (
            <div class="typography-recipe">
              <div class="typography-recipe-name">
                <b>{recipe.name}</b>
                <span>{recipe.meta}</span>
              </div>
              <p class={`typography-specimen ${recipe.className}`} data-typography-sample>
                Make structure visible without shouting.
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</section>
