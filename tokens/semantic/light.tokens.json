{
  "semantic": {
    "color": {
      "background": {
        "default":  { "$value": "{color.clay.50}",       "$type": "color" },
        "raised":   { "$value": "{color.white}",         "$type": "color" },
        "sunken":   { "$value": "{color.clay.100}",      "$type": "color" },
        "muted":    { "$value": "{color.blueSmoke.100}", "$type": "color" }
      },
      "foreground": {
        "default":  { "$value": "{color.blueSmoke.950}", "$type": "color" },
        "muted":    { "$value": "{color.blueSmoke.700}", "$type": "color" },
        "subtle":   { "$value": "{color.blueSmoke.500}", "$type": "color" },
        "faint":    { "$value": "{color.blueSmoke.400}", "$type": "color" },
        "onAccent": { "$value": "{color.clay.50}",       "$type": "color" },
        "inverse":  { "$value": "{color.clay.50}",       "$type": "color" }
      },
      "border": {
        "default": { "$value": "{color.blueSmoke.200}", "$type": "color" },
        "strong":  { "$value": "{color.blueSmoke.300}", "$type": "color" },
        "subtle":  { "$value": "{color.clay.200}",      "$type": "color" },
        "warm":    { "$value": "{color.robRoy.200}",    "$type": "color" }
      },
      "accent": {
        "default":    { "$value": "{color.robRoy.700}", "$type": "color" },
        "hover":      { "$value": "{color.robRoy.800}", "$type": "color" },
        "press":      { "$value": "{color.robRoy.900}", "$type": "color" },
        "soft":       { "$value": "{color.robRoy.100}", "$type": "color" },
        "foreground": { "$value": "{color.clay.50}",    "$type": "color" }
      },
      "secondary": {
        "default": { "$value": "{color.blueSmoke.700}", "$type": "color" },
        "hover":   { "$value": "{color.blueSmoke.800}", "$type": "color" },
        "soft":    { "$value": "{color.blueSmoke.100}", "$type": "color" }
      },
      "status": {
        "success": {
          "default":    { "$value": "{color.moss.500}", "$type": "color" },
          "foreground": { "$value": "{color.moss.700}", "$type": "color" },
          "background": { "$value": "{color.moss.100}", "$type": "color" }
        },
        "danger": {
          "default":    { "$value": "{color.rust.500}", "$type": "color" },
          "foreground": { "$value": "{color.rust.700}", "$type": "color" },
          "background": { "$value": "{color.rust.100}", "$type": "color" }
        },
        "warning": {
          "default":    { "$value": "{color.robRoy.600}", "$type": "color" },
          "foreground": { "$value": "{color.robRoy.800}", "$type": "color" },
          "background": { "$value": "{color.robRoy.100}", "$type": "color" }
        },
        "info": {
          "default":    { "$value": "{color.sky.500}", "$type": "color" },
          "foreground": { "$value": "{color.sky.700}", "$type": "color" },
          "background": { "$value": "{color.sky.100}", "$type": "color" }
        }
      }
    }
  }
}
