{
  "component": {
    "badge": {
      "radius":     { "$value": "{primitives.radius.full}", "$type": "dimension" },
      "paddingX":   { "$value": "{primitives.space.2}",     "$type": "dimension" },
      "paddingY":   { "$value": "{primitives.space.px}",    "$type": "dimension" },
      "fontSize":   { "$value": "{primitives.text.xs}",     "$type": "dimension" },
      "fontWeight": { "$value": "{primitives.weight.medium}", "$type": "fontWeight" },
      "default": {
        "bg":     { "$value": "{semantic.color.background.muted}",    "$type": "color" },
        "fg":     { "$value": "{semantic.color.foreground.muted}",    "$type": "color" },
        "border": { "$value": "{semantic.color.border.default}",      "$type": "color" }
      },
      "accent": {
        "bg":     { "$value": "{semantic.color.accent.soft}",         "$type": "color" },
        "fg":     { "$value": "{semantic.color.accent.default}",      "$type": "color" },
        "border": { "$value": "{semantic.color.border.warm}",         "$type": "color" }
      },
      "success": {
        "bg":     { "$value": "{semantic.color.status.success.background}", "$type": "color" },
        "fg":     { "$value": "{semantic.color.status.success.foreground}", "$type": "color" },
        "border": { "$value": "{semantic.color.status.success.background}", "$type": "color" }
      },
      "danger": {
        "bg":     { "$value": "{semantic.color.status.danger.background}",  "$type": "color" },
        "fg":     { "$value": "{semantic.color.status.danger.foreground}",  "$type": "color" },
        "border": { "$value": "{semantic.color.status.danger.background}",  "$type": "color" }
      },
      "warning": {
        "bg":     { "$value": "{semantic.color.status.warning.background}", "$type": "color" },
        "fg":     { "$value": "{semantic.color.status.warning.foreground}", "$type": "color" },
        "border": { "$value": "{semantic.color.status.warning.background}", "$type": "color" }
      },
      "info": {
        "bg":     { "$value": "{semantic.color.status.info.background}",    "$type": "color" },
        "fg":     { "$value": "{semantic.color.status.info.foreground}",    "$type": "color" },
        "border": { "$value": "{semantic.color.status.info.background}",    "$type": "color" }
      }
    }
  }
}
