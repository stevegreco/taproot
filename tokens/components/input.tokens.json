{
  "component": {
    "input": {
      "bg":              { "$value": "{semantic.color.background.raised}",  "$type": "color" },
      "bgDisabled":      { "$value": "{semantic.color.background.muted}",   "$type": "color" },
      "border":          { "$value": "{semantic.color.border.default}",     "$type": "color" },
      "borderHover":     { "$value": "{semantic.color.border.strong}",      "$type": "color" },
      "borderFocus":     { "$value": "{semantic.color.accent.default}",     "$type": "color" },
      "borderError":     { "$value": "{semantic.color.status.danger.default}", "$type": "color" },
      "fg":              { "$value": "{semantic.color.foreground.default}",  "$type": "color" },
      "fgPlaceholder":   { "$value": "{semantic.color.foreground.faint}",    "$type": "color" },
      "fgDisabled":      { "$value": "{semantic.color.foreground.subtle}",   "$type": "color" },
      "labelFg":         { "$value": "{semantic.color.foreground.muted}",    "$type": "color" },
      "hintFg":          { "$value": "{semantic.color.foreground.subtle}",   "$type": "color" },
      "errorFg":         { "$value": "{semantic.color.status.danger.foreground}", "$type": "color" },
