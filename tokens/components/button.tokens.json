{
  "component": {
    "button": {
      "radiusMd":  { "$value": "{primitives.radius.md}", "$type": "dimension" },
      "radiusFull": { "$value": "{primitives.radius.full}", "$type": "dimension" },
      "paddingX":  { "$value": "{primitives.space.4}", "$type": "dimension" },
      "paddingY":  { "$value": "{primitives.space.3}", "$type": "dimension" },
      "paddingXSm": { "$value": "{primitives.space.3}", "$type": "dimension" },
      "paddingYSm": { "$value": "{primitives.space.2}", "$type": "dimension" },
      "fontFamily": { "$value": "{primitives.font.sans}", "$type": "fontFamily" },
      "fontWeight": { "$value": "{primitives.weight.medium}", "$type": "fontWeight" },
      "fontSize":   { "$value": "{primitives.text.sm}", "$type": "dimension" },
      "transition": { "$value": "{primitives.duration.fast}", "$type": "duration" },
      "primary": {
        "bg":         { "$value": "{semantic.color.accent.default}",    "$type": "color" },
        "bgHover":    { "$value": "{semantic.color.accent.hover}",      "$type": "color" },
        "bgPress":    { "$value": "{semantic.color.accent.press}",      "$type": "color" },
        "fg":         { "$value": "{semantic.color.accent.foreground}", "$type": "color" },
        "border":     { "$value": "{semantic.color.accent.default}",    "$type": "color" }
      },
      "secondary": {
        "bg":         { "$value": "transparent",                         "$type": "color" },
        "bgHover":    { "$value": "{semantic.color.secondary.soft}",     "$type": "color" },
        "bgPress":    { "$value": "{semantic.color.secondary.soft}",     "$type": "color" },
        "fg":         { "$value": "{semantic.color.secondary.default}",  "$type": "color" },
        "border":     { "$value": "{semantic.color.border.default}",     "$type": "color" }
      },
      "ghost": {
        "bg":         { "$value": "transparent",                        "$type": "color" },
        "bgHover":    { "$value": "{semantic.color.secondary.soft}",    "$type": "color" },
        "fg":         { "$value": "{semantic.color.foreground.default}", "$type": "color" },
        "border":     { "$value": "transparent",                        "$type": "color" }
      },
      "danger": {
        "bg":         { "$value": "{semantic.color.status.danger.default}",    "$type": "color" },
        "bgHover":    { "$value": "{semantic.color.status.danger.foreground}", "$type": "color" },
        "fg":         { "$value": "{primitives.color.white}",                  "$type": "color" },
        "border":     { "$value": "{semantic.color.status.danger.default}",    "$type": "color" }
      }
    }
  }
}
