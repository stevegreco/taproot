{
  "semantic": {
    "color": {
      "background": {
        "default":  { "$value": "{primitives.color.blueSmoke.950}", "$type": "color" },
        "raised":   { "$value": "{primitives.color.blueSmoke.900}", "$type": "color" },
        "sunken":   { "$value": "{primitives.color.blueSmoke.975}", "$type": "color" },
        "muted":    { "$value": "{primitives.color.blueSmoke.800}", "$type": "color" }
      },
      "foreground": {
        "default":  { "$value": "{primitives.color.clay.50}",       "$type": "color" },
        "muted":    { "$value": "{primitives.color.blueSmoke.100}", "$type": "color" },
        "subtle":   { "$value": "{primitives.color.blueSmoke.200}", "$type": "color" },
        "faint":    { "$value": "{primitives.color.blueSmoke.300}", "$type": "color" },
        "inverse":  { "$value": "{primitives.color.blueSmoke.950}", "$type": "color" }
      },
      "border": {
        "default": { "$value": "{primitives.color.blueSmoke.400}", "$type": "color" },
        "strong":  { "$value": "{primitives.color.blueSmoke.300}", "$type": "color" },
        "subtle":  { "$value": "{primitives.color.blueSmoke.900}", "$type": "color" },
        "warm":    { "$value": "{primitives.color.robRoy.800}",    "$type": "color" }
      },
      "accent": {
        "default":    { "$value": "{primitives.color.robRoy.400}", "$type": "color" },
        "hover":      { "$value": "{primitives.color.robRoy.300}", "$type": "color" },
        "press":      { "$value": "{primitives.color.robRoy.200}", "$type": "color" },
        "soft":       { "$value": "{primitives.color.surface.robRoy.deep}", "$type": "color" },
        "foreground": { "$value": "{primitives.color.blueSmoke.950}", "$type": "color" }
      },
      "secondary": {
        "default":   { "$value": "{primitives.color.blueSmoke.200}", "$type": "color" },
        "soft":      { "$value": "{primitives.color.blueSmoke.800}", "$type": "color" },
        "softPress": { "$value": "{primitives.color.blueSmoke.700}", "$type": "color" }
      },
      "disabled": {
        "background": { "$value": "{primitives.color.blueSmoke.900}", "$type": "color" },
        "foreground": { "$value": "{primitives.color.blueSmoke.300}", "$type": "color" },
        "border":     { "$value": "{primitives.color.blueSmoke.800}", "$type": "color" }
      },
      "focus": {
        "ring": { "$value": "{primitives.color.robRoy.400}", "$type": "color" }
      },
      "status": {
        "success": {
          "default":    { "$value": "{primitives.color.moss.400}", "$type": "color" },
          "hover":      { "$value": "{primitives.color.moss.300}", "$type": "color" },
          "press":      { "$value": "{primitives.color.moss.200}", "$type": "color" },
          "onDefault":  { "$value": "{primitives.color.blueSmoke.950}", "$type": "color" },
          "foreground": { "$value": "{primitives.color.moss.100}", "$type": "color" },
          "background": { "$value": "{primitives.color.surface.moss.muted}", "$type": "color" }
        },
        "danger": {
          "default":    { "$value": "{primitives.color.rust.400}", "$type": "color" },
          "hover":      { "$value": "{primitives.color.rust.300}", "$type": "color" },
          "press":      { "$value": "{primitives.color.rust.200}", "$type": "color" },
          "onDefault":  { "$value": "{primitives.color.blueSmoke.950}", "$type": "color" },
          "foreground": { "$value": "{primitives.color.rust.100}", "$type": "color" },
          "background": { "$value": "{primitives.color.surface.rust.muted}", "$type": "color" }
        },
        "warning": {
          "default":    { "$value": "{primitives.color.amber.400}", "$type": "color" },
          "hover":      { "$value": "{primitives.color.amber.300}", "$type": "color" },
          "press":      { "$value": "{primitives.color.amber.200}", "$type": "color" },
          "onDefault":  { "$value": "{primitives.color.blueSmoke.950}", "$type": "color" },
          "foreground": { "$value": "{primitives.color.amber.100}", "$type": "color" },
          "background": { "$value": "{primitives.color.surface.amber.muted}", "$type": "color" }
        },
        "info": {
          "default":    { "$value": "{primitives.color.sky.400}", "$type": "color" },
          "hover":      { "$value": "{primitives.color.sky.300}", "$type": "color" },
          "press":      { "$value": "{primitives.color.sky.200}", "$type": "color" },
          "onDefault":  { "$value": "{primitives.color.blueSmoke.950}", "$type": "color" },
          "foreground": { "$value": "{primitives.color.sky.100}", "$type": "color" },
          "background": { "$value": "{primitives.color.surface.sky.muted}", "$type": "color" }
        }
      }
    },
    "elevation": {
      "xs":    { "$value": "{primitives.shadowInk.xs}",    "$type": "shadow" },
      "sm":    { "$value": "{primitives.shadowInk.sm}",    "$type": "shadow" },
      "md":    { "$value": "{primitives.shadowInk.md}",    "$type": "shadow" },
      "lg":    { "$value": "{primitives.shadowInk.lg}",    "$type": "shadow" },
      "xl":    { "$value": "{primitives.shadowInk.xl}",    "$type": "shadow" },
      "inset": { "$value": "{primitives.shadowInk.inset}", "$type": "shadow" }
    }
  }
}
