{
  "semantic": {
    "color": {
      "background": {
        "default":  { "$value": "{primitives.color.clay.50}",       "$type": "color" },
        "raised":   { "$value": "{primitives.color.white}",         "$type": "color" },
        "sunken":   { "$value": "{primitives.color.clay.100}",      "$type": "color" },
        "muted":    { "$value": "{primitives.color.blueSmoke.100}", "$type": "color" }
      },
      "foreground": {
        "default":  { "$value": "{primitives.color.blueSmoke.950}", "$type": "color" },
        "muted":    { "$value": "{primitives.color.blueSmoke.700}", "$type": "color" },
        "subtle":   { "$value": "{primitives.color.blueSmoke.600}", "$type": "color" },
        "faint":    { "$value": "{primitives.color.blueSmoke.500}", "$type": "color" },
        "inverse":  { "$value": "{primitives.color.clay.50}",       "$type": "color" }
      },
      "border": {
        "default": { "$value": "{primitives.color.blueSmoke.500}", "$type": "color" },
        "strong":  { "$value": "{primitives.color.blueSmoke.600}", "$type": "color" },
        "subtle":  { "$value": "{primitives.color.clay.200}",      "$type": "color" },
        "warm":    { "$value": "{primitives.color.robRoy.200}",    "$type": "color" }
      },
      "accent": {
        "default":    { "$value": "{primitives.color.robRoy.700}", "$type": "color" },
        "hover":      { "$value": "{primitives.color.robRoy.800}", "$type": "color" },
        "press":      { "$value": "{primitives.color.robRoy.900}", "$type": "color" },
        "soft":       { "$value": "{primitives.color.robRoy.100}", "$type": "color" },
        "foreground": { "$value": "{primitives.color.clay.50}",    "$type": "color" }
      },
      "secondary": {
        "default":   { "$value": "{primitives.color.blueSmoke.700}", "$type": "color" },
        "soft":      { "$value": "{primitives.color.blueSmoke.100}", "$type": "color" },
        "softPress": { "$value": "{primitives.color.blueSmoke.200}", "$type": "color" }
      },
      "disabled": {
        "background": { "$value": "{primitives.color.clay.100}",      "$type": "color" },
        "foreground": { "$value": "{primitives.color.blueSmoke.500}", "$type": "color" },
        "border":     { "$value": "{primitives.color.clay.200}",      "$type": "color" }
      },
      "focus": {
        "ring": { "$value": "{primitives.color.robRoy.700}", "$type": "color" }
      },
      "status": {
        "success": {
          "default":    { "$value": "{primitives.color.moss.700}", "$type": "color" },
          "hover":      { "$value": "{primitives.color.moss.800}", "$type": "color" },
          "press":      { "$value": "{primitives.color.moss.900}", "$type": "color" },
          "onDefault":  { "$value": "{primitives.color.white}",    "$type": "color" },
          "foreground": { "$value": "{primitives.color.moss.800}", "$type": "color" },
          "background": { "$value": "{primitives.color.moss.100}", "$type": "color" }
        },
        "danger": {
          "default":    { "$value": "{primitives.color.rust.700}", "$type": "color" },
          "hover":      { "$value": "{primitives.color.rust.800}", "$type": "color" },
          "press":      { "$value": "{primitives.color.rust.900}", "$type": "color" },
          "onDefault":  { "$value": "{primitives.color.white}",    "$type": "color" },
          "foreground": { "$value": "{primitives.color.rust.800}", "$type": "color" },
          "background": { "$value": "{primitives.color.rust.100}", "$type": "color" }
        },
        "warning": {
          "default":    { "$value": "{primitives.color.amber.700}", "$type": "color" },
          "hover":      { "$value": "{primitives.color.amber.800}", "$type": "color" },
          "press":      { "$value": "{primitives.color.amber.900}", "$type": "color" },
          "onDefault":  { "$value": "{primitives.color.white}",     "$type": "color" },
          "foreground": { "$value": "{primitives.color.amber.800}", "$type": "color" },
          "background": { "$value": "{primitives.color.amber.100}", "$type": "color" }
        },
        "info": {
          "default":    { "$value": "{primitives.color.sky.700}", "$type": "color" },
          "hover":      { "$value": "{primitives.color.sky.800}", "$type": "color" },
          "press":      { "$value": "{primitives.color.sky.900}", "$type": "color" },
          "onDefault":  { "$value": "{primitives.color.white}",   "$type": "color" },
          "foreground": { "$value": "{primitives.color.sky.800}", "$type": "color" },
          "background": { "$value": "{primitives.color.sky.100}", "$type": "color" }
        }
      }
    },
    "elevation": {
      "xs":    { "$value": "{primitives.shadow.xs}",    "$type": "shadow" },
      "sm":    { "$value": "{primitives.shadow.sm}",    "$type": "shadow" },
      "md":    { "$value": "{primitives.shadow.md}",    "$type": "shadow" },
      "lg":    { "$value": "{primitives.shadow.lg}",    "$type": "shadow" },
      "xl":    { "$value": "{primitives.shadow.xl}",    "$type": "shadow" },
      "inset": { "$value": "{primitives.shadow.inset}", "$type": "shadow" }
    }
  }
}
