{
  "component": {
    "button": {
      "radiusMd":  { "$value": "{semantic.radius.control}", "$type": "dimension" },
      "radiusFull": { "$value": "{semantic.radius.pill}", "$type": "dimension" },
      "paddingX":  { "$value": "{primitives.space.4}", "$type": "dimension" },
      "paddingY":  { "$value": "{primitives.space.3}", "$type": "dimension" },
      "paddingXSm": { "$value": "{primitives.space.3}", "$type": "dimension" },
      "paddingYSm": { "$value": "{primitives.space.2}", "$type": "dimension" },
      "fontFamily": { "$value": "{primitives.font.sans}", "$type": "fontFamily" },
      "fontWeight": { "$value": "{primitives.weight.medium}", "$type": "fontWeight" },
      "fontSize":   { "$value": "{primitives.text.sm}", "$type": "dimension" },
      "transition": { "$value": "{primitives.duration.fast}", "$type": "duration" },
      "primary": {
        "background":         { "$value": "{semantic.color.accent.default}",     "$type": "color" },
        "backgroundHover":    { "$value": "{semantic.color.accent.hover}",       "$type": "color" },
        "backgroundPress":    { "$value": "{semantic.color.accent.press}",       "$type": "color" },
        "backgroundDisabled": { "$value": "{semantic.color.disabled.background}", "$type": "color" },
        "foreground":         { "$value": "{semantic.color.accent.foreground}",  "$type": "color" },
        "foregroundDisabled": { "$value": "{semantic.color.disabled.foreground}", "$type": "color" },
        "border":             { "$value": "{semantic.color.accent.default}",     "$type": "color" },
        "borderDisabled":     { "$value": "{semantic.color.disabled.border}",    "$type": "color" }
      },
      "secondary": {
        "background":         { "$value": "transparent",                          "$type": "color" },
        "backgroundHover":    { "$value": "{semantic.color.secondary.soft}",      "$type": "color" },
        "backgroundPress":    { "$value": "{semantic.color.secondary.soft}",      "$type": "color" },
        "backgroundDisabled": { "$value": "transparent",                          "$type": "color" },
        "foreground":         { "$value": "{semantic.color.secondary.default}",   "$type": "color" },
        "foregroundDisabled": { "$value": "{semantic.color.disabled.foreground}", "$type": "color" },
        "border":             { "$value": "{semantic.color.border.default}",      "$type": "color" },
        "borderDisabled":     { "$value": "{semantic.color.disabled.border}",     "$type": "color" }
      },
      "ghost": {
        "background":         { "$value": "transparent",                          "$type": "color" },
        "backgroundHover":    { "$value": "{semantic.color.secondary.soft}",      "$type": "color" },
        "backgroundDisabled": { "$value": "transparent",                          "$type": "color" },
        "foreground":         { "$value": "{semantic.color.foreground.default}",  "$type": "color" },
        "foregroundDisabled": { "$value": "{semantic.color.disabled.foreground}", "$type": "color" },
        "border":             { "$value": "transparent",                          "$type": "color" },
        "borderDisabled":     { "$value": "transparent",                          "$type": "color" }
      },
      "danger": {
        "background":         { "$value": "{semantic.color.status.danger.default}",   "$type": "color" },
        "backgroundHover":    { "$value": "{semantic.color.status.danger.hover}",     "$type": "color" },
        "backgroundDisabled": { "$value": "{semantic.color.disabled.background}",     "$type": "color" },
        "foreground":         { "$value": "{semantic.color.status.danger.onDefault}", "$type": "color" },
        "foregroundDisabled": { "$value": "{semantic.color.disabled.foreground}",     "$type": "color" },
        "border":             { "$value": "{semantic.color.status.danger.default}",   "$type": "color" },
        "borderDisabled":     { "$value": "{semantic.color.disabled.border}",         "$type": "color" }
      }
    }
  }
}
