{
  "component": {
    "alert": {
      "radius":   { "$value": "{primitives.radius.md}", "$type": "dimension" },
      "padding":  { "$value": "{primitives.space.4}",   "$type": "dimension" },
      "gap":      { "$value": "{primitives.space.3}",   "$type": "dimension" },
      "fontSize": { "$value": "{primitives.text.sm}",   "$type": "dimension" },
      "titleFontWeight": { "$value": "{primitives.weight.semibold}", "$type": "fontWeight" },
      "success": {
        "background":  { "$value": "{semantic.color.status.success.background}", "$type": "color" },
        "foreground":  { "$value": "{semantic.color.status.success.foreground}", "$type": "color" },
        "iconColor":   { "$value": "{semantic.color.status.success.default}",    "$type": "color" },
        "border":      { "$value": "{semantic.color.status.success.background}", "$type": "color" }
      },
      "danger": {
        "background":  { "$value": "{semantic.color.status.danger.background}",  "$type": "color" },
        "foreground":  { "$value": "{semantic.color.status.danger.foreground}",  "$type": "color" },
        "iconColor":   { "$value": "{semantic.color.status.danger.default}",     "$type": "color" },
        "border":      { "$value": "{semantic.color.status.danger.background}",  "$type": "color" }
      },
      "warning": {
        "background":  { "$value": "{semantic.color.status.warning.background}", "$type": "color" },
        "foreground":  { "$value": "{semantic.color.status.warning.foreground}", "$type": "color" },
        "iconColor":   { "$value": "{semantic.color.status.warning.default}",    "$type": "color" },
        "border":      { "$value": "{semantic.color.status.warning.background}", "$type": "color" }
      },
      "info": {
        "background":  { "$value": "{semantic.color.status.info.background}",    "$type": "color" },
        "foreground":  { "$value": "{semantic.color.status.info.foreground}",    "$type": "color" },
        "iconColor":   { "$value": "{semantic.color.status.info.default}",       "$type": "color" },
        "border":      { "$value": "{semantic.color.status.info.background}",    "$type": "color" }
      }
    }
  }
}
