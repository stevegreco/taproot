      "paddingY":              { "$value": "{primitives.space.2}",   "$type": "dimension" },
      "shadow":                { "$value": "{primitives.shadow.inset}", "$type": "shadow" },
      "shadowFocus":           { "$value": "{primitives.shadow.xs}",    "$type": "shadow" },
      "fontFamily":            { "$value": "{primitives.font.sans}",    "$type": "fontFamily" },
      "fontSize":              { "$value": "{primitives.text.sm}",      "$type": "dimension" }
    }
  }
