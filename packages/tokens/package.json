{
  "name": "@taproot-ds/tokens",
  "version": "0.2.0",
  "description": "Design tokens distributed as CSS and JSON artifacts.",
  "keywords": [
    "css-variables",
    "design-system",
    "design-tokens"
  ],
  "license": "ISC",
  "author": "Steve Greco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevegreco/taproot.git",
    "directory": "packages/tokens"
  },
  "style": "./dist/css/tokens.css",
  "files": [
    "dist",
    "src/tokens"
  ],
  "type": "module",
  "main": "./dist/css/tokens.css",
  "exports": {
    ".": "./dist/css/tokens.css",
    "./css": "./dist/css/tokens.css",
    "./base": "./dist/css/base.css",
    "./base.css": "./dist/css/base.css",
    "./tokens/primitives": "./dist/tokens/primitives.json",
    "./tokens/semantic-light": "./dist/tokens/semantic.light.json",
    "./tokens/semantic-dark": "./dist/tokens/semantic.dark.json",
    "./tokens/semantic-meta": "./dist/tokens/semantic.meta.json",
    "./read-tokens": "./dist/read-tokens.js",
    "./flatten": "./dist/flatten.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && node build-tokens.js && node build-css.js && pnpm run audit:tokens",
    "audit:tokens": "node scripts/audit.js",
    "watch": "chokidar \"src/tokens/**/*.json\" -c \"pnpm run build\" --initial",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "style-dictionary": "^5.5.0",
    "vitest": "^5.0.0"
  }
}
