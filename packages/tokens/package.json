{
  "name": "@stevegreco/design-system",
  "version": "0.0.5",
  "description": "Design tokens distributed as CSS and JSON artifacts.",
  "keywords": [
    "css-variables",
    "design-system",
    "design-tokens"
  ],
  "license": "ISC",
  "author": "Steve Greco",
  "style": "./dist/css/tokens.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/tokens/primitives.json",
  "exports": {
    ".": "./dist/tokens/primitives.json",
    "./css": "./dist/css/tokens.css",
    "./tokens/primitives": "./dist/tokens/primitives.json",
    "./tokens/semantic-light": "./dist/tokens/semantic.light.json",
    "./tokens/semantic-dark": "./dist/tokens/semantic.dark.json",
    "./tokens/components": "./dist/tokens/components.json",
    "./read-tokens": "./dist/read-tokens.js",
    "./flatten": "./dist/flatten.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && node build-tokens.js && node build-css.js && pnpm run audit",
    "audit": "node scripts/audit.js",
    "watch": "chokidar \"src/tokens/**/*.json\" -c \"pnpm run build\" --initial",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "style-dictionary": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.4"
}
