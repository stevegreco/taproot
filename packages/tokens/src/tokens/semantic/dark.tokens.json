{
  "semantic": {
    "color": {
      "background": {
        "default": {
          "$value": "{primitives.color.blueSmoke.950}",
          "$type": "color",
          "$description": "Page or application background"
        },
        "surface": {
          "$value": "{primitives.color.blueSmoke.900}",
          "$type": "color",
          "$description": "Cards, panels, popovers, and containing surfaces"
        },
        "sunken": {
          "$value": "{primitives.color.blueSmoke.975}",
          "$type": "color",
          "$description": "Wells, inset regions, and grouped control beds"
        },
        "muted": {
          "$value": "{primitives.color.blueSmoke.800}",
          "$type": "color",
          "$description": "Quiet supporting regions and low-emphasis fills"
        },
        "disabled": {
          "$value": "{primitives.color.gray.900}",
          "$type": "color",
          "$description": "Unavailable control or action fill"
        },
        "overlay": {
          "$value": "{primitives.color.grayAlpha.950.75}",
          "$type": "color",
          "$description": "Scrim that dims the page behind modal content"
        },
        "brand": {
          "default": { "$value": "{primitives.color.robRoy.400}", "$type": "color" },
          "muted": { "$value": "{primitives.color.robRoy.950}", "$type": "color" }
        },
        "action": {
          "primary": {
            "default": { "$value": "{primitives.color.robRoy.400}", "$type": "color" },
            "hover": { "$value": "{primitives.color.robRoy.300}", "$type": "color" },
            "pressed": { "$value": "{primitives.color.robRoy.200}", "$type": "color" }
          },
          "secondary": {
            "default": { "$value": "{primitives.color.gray.900}", "$type": "color" },
            "hover": { "$value": "{primitives.color.gray.800}", "$type": "color" },
            "pressed": { "$value": "{primitives.color.gray.700}", "$type": "color" }
          },
          "tertiary": {
            "hover": { "$value": "{primitives.color.grayAlpha.25.6}", "$type": "color" },
            "pressed": { "$value": "{primitives.color.grayAlpha.25.10}", "$type": "color" }
          },
          "destructive": {
            "default": { "$value": "{primitives.color.rust.400}", "$type": "color" },
            "hover": { "$value": "{primitives.color.rust.300}", "$type": "color" },
            "pressed": { "$value": "{primitives.color.rust.200}", "$type": "color" }
          }
        },
        "status": {
          "success": { "default": { "$value": "{primitives.color.moss.900}", "$type": "color" } },
          "warning": { "default": { "$value": "{primitives.color.amber.900}", "$type": "color" } },
          "info": { "default": { "$value": "{primitives.color.sky.800}", "$type": "color" } },
          "danger": { "default": { "$value": "{primitives.color.rust.800}", "$type": "color" } }
        }
      },
      "foreground": {
        "default": {
          "$value": "{primitives.color.gray.25}",
          "$type": "color",
          "$description": "Primary text and icons on supported foundation and quiet status backgrounds"
        },
        "muted": {
          "$value": "{primitives.color.gray.300}",
          "$type": "color",
          "$description": "Secondary or supporting text and icons"
        },
        "disabled": {
          "$value": "{primitives.color.gray.500}",
          "$type": "color",
          "$description": "Unavailable text and icons"
        },
        "brand": {
          "default": { "$value": "{primitives.color.robRoy.400}", "$type": "color" }
        },
        "on": {
          "brand": { "$value": "{primitives.color.gray.950}", "$type": "color" },
          "action": {
            "primary": { "$value": "{primitives.color.gray.950}", "$type": "color" },
            "destructive": { "$value": "{primitives.color.gray.950}", "$type": "color" }
          }
        },
        "status": {
          "success": { "default": { "$value": "{primitives.color.moss.100}", "$type": "color" } },
          "warning": { "default": { "$value": "{primitives.color.amber.100}", "$type": "color" } },
          "info": { "default": { "$value": "{primitives.color.sky.100}", "$type": "color" } },
          "danger": { "default": { "$value": "{primitives.color.rust.100}", "$type": "color" } }
        }
      },
      "border": {
        "default": {
          "$value": "{primitives.color.gray.400}",
          "$type": "color",
          "$description": "Standard functional boundary for controls and other perceivable regions"
        },
        "strong": {
          "$value": "{primitives.color.gray.300}",
          "$type": "color",
          "$description": "Emphasized functional boundary"
        },
        "subtle": {
          "$value": "{primitives.color.gray.800}",
          "$type": "color",
          "$description": "Decorative dividers and quiet surface edges"
        },
        "disabled": {
          "$value": "{primitives.color.gray.700}",
          "$type": "color",
          "$description": "Unavailable control boundary"
        },
        "focus": {
          "$value": "{primitives.color.robRoy.400}",
          "$type": "color",
          "$description": "Focus indicator, whether rendered as a border or an outline"
        },
        "action": {
          "primary": {
            "default": { "$value": "{primitives.color.robRoy.400}", "$type": "color" },
            "hover": { "$value": "{primitives.color.robRoy.300}", "$type": "color" },
            "pressed": { "$value": "{primitives.color.robRoy.200}", "$type": "color" }
          },
          "destructive": {
            "default": { "$value": "{primitives.color.rust.400}", "$type": "color" },
            "hover": { "$value": "{primitives.color.rust.300}", "$type": "color" },
            "pressed": { "$value": "{primitives.color.rust.200}", "$type": "color" }
          }
        },
        "brand": {
          "muted": { "$value": "{primitives.color.robRoy.800}", "$type": "color" }
        },
        "status": {
          "success": { "default": { "$value": "{primitives.color.moss.300}", "$type": "color" } },
          "warning": { "default": { "$value": "{primitives.color.amber.300}", "$type": "color" } },
          "info": { "default": { "$value": "{primitives.color.sky.300}", "$type": "color" } },
          "danger": { "default": { "$value": "{primitives.color.rust.300}", "$type": "color" } }
        }
      }
    },
    "elevation": {
      "xs": {
        "$value": "{primitives.shadowInk.xs}",
        "$type": "shadow",
        "$description": "Subtle lift for resting controls and small raised details"
      },
      "sm": {
        "$value": "{primitives.shadowInk.sm}",
        "$type": "shadow",
        "$description": "Cards and raised surfaces at rest"
      },
      "md": {
        "$value": "{primitives.shadowInk.md}",
        "$type": "shadow",
        "$description": "Popovers, menus, and raised surfaces on hover"
      },
      "lg": {
        "$value": "{primitives.shadowInk.lg}",
        "$type": "shadow",
        "$description": "Dialogs and other modal surfaces"
      },
      "xl": {
        "$value": "{primitives.shadowInk.xl}",
        "$type": "shadow",
        "$description": "Highest overlays that must stand apart from all other content"
      },
      "inset": {
        "$value": "{primitives.shadowInk.inset}",
        "$type": "shadow",
        "$description": "Wells, tracks, and recessed regions"
      }
    }
  }
}
