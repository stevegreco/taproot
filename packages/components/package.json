{
  "name": "@stevegreco/design-system-components",
  "version": "0.0.1",
  "description": "Framework-agnostic web components styled entirely with design system tokens.",
  "keywords": [
    "custom-elements",
    "design-system",
    "web-components"
  ],
  "license": "ISC",
  "author": "Steve Greco",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.js"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "default": "./src/*.js"
    },
    "./index": null,
    "./internal/*": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build-styles.js && node build-sources.js",
    "test": "vitest run",
    "watch": "chokidar \"src/**/*.css\" -c \"node build-styles.js\" --initial",
    "dev": "pnpm run watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@stevegreco/design-system": "workspace:*"
  },
  "devDependencies": {
    "@stevegreco/design-system-knowledge": "workspace:*",
    "@vitest/browser-playwright": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "vitest": "^5.0.0"
  }
}
