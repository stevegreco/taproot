{
  "name": "@stevegreco/design-system-components",
  "version": "0.0.1",
  "description": "Framework-agnostic web components styled entirely with design system tokens.",
  "keywords": [
    "badge",
    "button",
    "custom-elements",
    "design-system",
    "text-field",
    "web-components"
  ],
  "license": "ISC",
  "author": "Steve Greco",
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.js"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "default": "./src/*.js"
    },
    "./internal/*": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build-styles.js",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "watch": "chokidar \"src/**/*.css\" -c \"node build-styles.js\" --initial",
    "serve": "live-server --port=4500 --open=examples/button.html .",
    "dev": "concurrently -n build,serve -c blue,green \"pnpm run watch\" \"pnpm run serve\"",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@stevegreco/design-system": "workspace:*"
  },
  "devDependencies": {
    "@stevegreco/design-system-knowledge": "workspace:*",
    "@vitest/browser-playwright": "^5.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.0",
    "live-server": "^1.2.2",
    "vitest": "^5.0.0"
  }
}
