{
  "name": "@taproot-ds/web-components",
  "version": "0.2.0",
  "description": "Framework-agnostic web components styled entirely with design system tokens.",
  "keywords": [
    "custom-elements",
    "design-system",
    "web-components"
  ],
  "license": "ISC",
  "author": "Steve Greco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevegreco/taproot.git",
    "directory": "packages/components"
  },
  "files": [
    "src",
    "dist",
    "implementation",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.js"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "default": "./src/*.js"
    },
    "./package.json": "./package.json",
    "./index": null,
    "./internal/*": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build-styles.js && node build-index.js",
    "test": "vitest run",
    "watch": "chokidar \"src/**/*.css\" -c \"node build-styles.js\" --initial",
    "dev": "pnpm run watch",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@taproot-ds/tokens": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.0",
    "axe-core": "^4.13.0",
    "chokidar-cli": "^3.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
