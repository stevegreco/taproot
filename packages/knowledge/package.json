{
  "name": "@stevegreco/design-system-knowledge",
  "version": "0.0.1",
  "description": "Portable, validated knowledge records for the Ember & Sage design system.",
  "license": "ISC",
  "author": "Steve Greco",
  "files": [
    "dist/public",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./compile": "./src/compile/index.js",
    "./retrieve": "./src/retrieve/index.js",
