{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stevegreco:design-system:portable-contract:5",
  "title": "Portable component contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "description",
    "usage",
    "anatomy",
    "parameters",
    "events",
    "states",
    "behavior",
    "accessibility"
  ],
  "properties": {
    "specVersion": {
      "const": 5
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "usage": {
      "$ref": "#/$defs/usage"
    },
    "content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "anatomy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anatomyPart"
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "configurationAxes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/configurationAxis"
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/event"
      }
    },
    "states": {
      "description": "States, highest priority first. For each channel, the first active state that sets it wins. default is the rest state and comes last.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "behavior": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "accessibility": {
      "$ref": "#/$defs/accessibility"
    },
    "rationale": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rationaleItem"
      }
    },
    "visuals": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/visualPart"
      }
    }
  },
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "avoid"],
      "properties": {
        "do": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usageDo"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/usageAvoid"
          }
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "dottedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
    },
    "usageDo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "situation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "situation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "usageAvoid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "situation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "situation": {
          "type": "string",
          "minLength": 1
        },
        "instead": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ruleReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/$defs/dottedId"
        },
        "fragment": {
          "$ref": "#/$defs/slug"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "statement"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "level": {
          "enum": ["must", "should", "may"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleReference"
          }
        },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "do": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "avoid": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "anatomyPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "description"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["interactive-surface", "label", "indicator", "container"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["enum", "boolean", "string"]
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "default": true,
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enum"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["values"],
            "properties": {
              "values": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "default": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "boolean"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              },
              "values": false,
              "examples": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "string"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "default": {
                "type": "string"
              },
              "values": false,
              "examples": false
            }
          }
        }
      ]
    },
    "configurationAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values"],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics", "name"],
      "properties": {
        "semantics": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "keyboard": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyboardBinding"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "keyboardBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "action"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rationaleItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "channelValue": {
      "type": "string",
      "minLength": 1
    },
    "channelMap": {
      "description": "Token names or literals for the visual channels.",
      "type": "object",
      "$ref": "#/$defs/channelMapProperties",
      "unevaluatedProperties": false
    },
    "stateMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/channelMap"
      }
    },
    "visualAxisValue": {
      "description": "Channels for one configuration value, and its states.",
      "type": "object",
      "$ref": "#/$defs/channelMapProperties",
      "properties": {
        "states": {
          "$ref": "#/$defs/stateMap"
        }
      },
      "unevaluatedProperties": false
    },
    "visualAxis": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/visualAxisValue"
      }
    },
    "visualPart": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/channelMap"
        },
        "states": {
          "$ref": "#/$defs/stateMap"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/visualAxis"
      }
    },
    "channelMapProperties": {
      "description": "The one list of visual channel names. channelMap and visualAxisValue close it.",
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/$defs/channelValue"
        },
        "foreground": {
          "$ref": "#/$defs/channelValue"
        },
        "border": {
          "$ref": "#/$defs/channelValue"
        },
        "focus-ring": {
          "$ref": "#/$defs/channelValue"
        },
        "padding-horizontal": {
          "$ref": "#/$defs/channelValue"
        },
        "padding-vertical": {
          "$ref": "#/$defs/channelValue"
        },
        "radius": {
          "$ref": "#/$defs/channelValue"
        },
        "gap": {
          "$ref": "#/$defs/channelValue"
        },
        "font-family": {
          "$ref": "#/$defs/channelValue"
        },
        "font-size": {
          "$ref": "#/$defs/channelValue"
        },
        "font-weight": {
          "$ref": "#/$defs/channelValue"
        },
        "line-height": {
          "$ref": "#/$defs/channelValue"
        },
        "letter-spacing": {
          "$ref": "#/$defs/channelValue"
        },
        "motion": {
          "$ref": "#/$defs/channelValue"
        },
        "motion-duration": {
          "$ref": "#/$defs/channelValue"
        },
        "motion-easing": {
          "$ref": "#/$defs/channelValue"
        }
      }
    }
  }
}
