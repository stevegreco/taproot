{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stevegreco:design-system:knowledge-record:1",
  "title": "Authored knowledge record",
  "type": "object",
  "required": ["id", "type", "title", "summary", "status", "jobs", "tags"],
  "properties": {
    "id": { "$ref": "#/$defs/dottedId" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "type": {
      "enum": ["component", "pattern", "guideline", "example", "foundation", "decision", "binding"]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["draft", "accepted", "deprecated", "superseded"]
    },
    "visibility": { "enum": ["public", "internal"] },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["design", "implement", "review"] }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "relations": { "$ref": "#/$defs/relations" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" },
      "contains": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "const": "authored" }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "body": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "guideline" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "items": { "$ref": "#/$defs/check" }
          },
          "docsSections": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "behavior": {
                "type": "object",
                "additionalProperties": false,
                "required": ["section", "heading"],
                "properties": {
                  "section": { "$ref": "#/$defs/slug" },
                  "heading": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "pattern" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "variantGuidance": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": { "$ref": "#/$defs/dottedId" },
            "additionalProperties": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/slug" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "example" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "assets": {
            "type": "array",
            "items": { "$ref": "#/$defs/asset" }
          },
          "annotations": {
            "type": "array",
            "items": { "$ref": "#/$defs/annotation" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "binding" } },
        "required": ["type"]
      },
      "then": {
        "required": ["host"],
        "properties": {
          "host": { "$ref": "#/$defs/hostBinding" }
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "component" } },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "tokenRef": { "$ref": "#/$defs/tokenRef" },
          "contract": { "$ref": "#/$defs/portableContract" }
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "dottedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*)+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "recordIdList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dottedId" }
    },
    "relations": {
      "type": "object",
      "properties": {
        "uses": { "$ref": "#/$defs/recordIdList" },
        "demonstrates": { "$ref": "#/$defs/recordIdList" },
        "guides": { "$ref": "#/$defs/recordIdList" },
        "implements": { "$ref": "#/$defs/recordIdList" },
        "reviews": { "$ref": "#/$defs/recordIdList" },
        "supersedes": { "$ref": "#/$defs/recordIdList" },
        "related": { "$ref": "#/$defs/recordIdList" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "enum": ["authored", "token-source", "adr"],
          "$comment": "generated is compiler-only and rejected in authored Markdown."
        },
        "path": { "$ref": "#/$defs/repositoryPath" }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["id", "level", "requirement"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "level": { "enum": ["error", "warning"] },
        "requirement": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["id", "path", "mediaType", "width", "height", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/dottedId" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z]+/[a-zA-Z0-9.+-]+$"
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "alt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "required": ["id", "label", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "relatesTo": { "$ref": "#/$defs/recordIdList" }
      },
      "additionalProperties": false
    },
    "portableContract": {
      "$ref": "urn:stevegreco:design-system:portable-contract:5"
    },
    "hostBinding": {
      "$ref": "urn:stevegreco:design-system:host-binding:1"
    },
    "tokenRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "namespace", "description"],
      "properties": {
        "tier": { "enum": ["primitive", "semantic", "component"] },
        "namespace": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
